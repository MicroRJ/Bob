expanded := " ":join({ "src", "vendor" }:map(fun(directory) {
	ret f"/I${directory}"
}))
elf.assert(expanded == "/Isrc /Ivendor", "elf map and join produced the wrong result")
elf.assert(elf.path.join("src/scripts", "libs") == "src/scripts/libs", "elf.path.join produced the wrong result")
elf.assert(elf.fs.exists("src/base.c"), "elf.fs.exists did not find src/base.c")
elf.assert(elf.fs.is_file("src/base.c"), "elf.fs.is_file did not recognize src/base.c")
elf.assert(elf.fs.is_directory("src/scripts"), "elf.fs.is_directory did not recognize src/scripts")

compare_paths := fun(left, right) {
	ret left:compare(right)
}

matching_files := fun(root, recursion, patterns) {
	prefix_length := root:length() + 1
	paths := elf.fs.get_paths(root, recursion):filter(fun(path) {
		if elf.fs.is_file(path) == false ? ret false
		relative := path:slice(prefix_length)
		for pattern := patterns[...] ? {
			if relative:glob_match(pattern) ? ret true
		}
		ret false
	})
	ret paths:map(fun(path) {
		ret path:slice(prefix_length)
	}):sort(compare_paths)
}

library_sources := matching_files("src/lib", 0, { "*.c", "*.h" })
elf.assert(library_sources:length() == 13, "elf filesystem primitives returned the wrong number of sources")
elf.assert(library_sources[0] == "bob.h", "elf filesystem results are not sorted")

recursive_sources := matching_files("src", 32, { "*.c" })
elf.assert(recursive_sources:length() == 14, "elf filesystem recursion returned the wrong number of sources")
elf.assert(recursive_sources[0] == "base.c", "recursive elf filesystem results are not sorted")

directory_root := "src"
directory_prefix_length := directory_root:length() + 1
directories := elf.fs.get_paths(directory_root, 0):filter(fun(path) {
	ret elf.fs.is_directory(path)
}):map(fun(path) {
	ret path:slice(directory_prefix_length)
})
directories:sort(compare_paths)
elf.assert(directories:length() == 2 && directories[0] == "lib", "elf filesystem directory filtering failed")

build := fun() {
	ret bob.build({
		targets = {},
		options = {
			workers = 1,
			verbosity = 0,
		},
	})
}

clean := fun() {
	ret 1
}

environment := fun() {
	name := "BOB_SCRIPT_ENV_TEST"
	elf.assert(elf.env.unset(name), "elf.env.unset failed")
	elf.assert(elf.env.has(name) == false, "elf.env.has found an unset variable")
	elf.assert(elf.env.set(name, "value"), "elf.env.set failed")
	elf.assert(elf.env.get(name) == "value", "elf.env.get returned the wrong value")
	ret elf.env.unset(name)
}

filesystem := fun() {
	root := "build/script_fs_test"
	elf.assert(elf.fs.remove_tree(root), "initial recursive removal failed")
	elf.assert(elf.fs.create_directory(root), "elf.fs.create_directory failed")
	nested := elf.path.join(root, "nested/deep")
	elf.assert(elf.fs.create_directories(nested), "elf.fs.create_directories failed")
	copy := elf.path.join(nested, "copy.h")
	moved := elf.path.join(nested, "moved.h")
	elf.assert(elf.fs.copy_file("src/base.h", copy), "elf.fs.copy_file failed")
	elf.assert(elf.fs.move_file(copy, moved), "elf.fs.move_file failed")
	elf.assert(elf.fs.exists(copy) == false && elf.fs.is_file(moved), "elf.fs.move_file produced the wrong files")
	elf.assert(elf.fs.remove_file(moved), "elf.fs.remove_file could not remove a file")
	ret elf.fs.remove_tree(root)
}

ret {
	build = build,
	clean = clean,
	environment = environment,
	filesystem = filesystem,
}
