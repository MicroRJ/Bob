
elf.fs.create_directory("build")

object_task ::= fun(name) {
	ret {
		name         = f"compile ${name}",
		command_line = f"clang-cl /nologo /W4 /c ${name}.c /Fobuild\\${name}.obj",
		inputs       = { f"${name}.c" },
		outputs      = { f"build/${name}.obj" },
		include_dirs = { "." },
	}
}

compile_main    ::= object_task("main")
compile_message ::= object_task("message")

link := {
	name = "link hello",
	command_line = "clang-cl /nologo build\\main.obj build\\message.obj /Febuild\\hello.exe",
	inputs = { "build/main.obj", "build/message.obj" },
	outputs = { "build/hello.exe" },
	dependencies = { compile_main, compile_message },
}

run := {
	name = "run hello",
	command_line = "build\\hello.exe",
	inputs = { "build/hello.exe" },
	outputs = {},
	dependencies = { link },
}

options := {
	workers = 4,
	verbosity = 0,
}

entries := {}

entries.build = fun() {
	ret bob.build({
		targets = { link },
		options = options,
	})
}

entries.run = fun() {
	ret bob.build({
		targets = { run },
		options = options,
	})
}

ret entries
